{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/client/public/$1" },
    { "src": "/game-assets/(.*)", "dest": "/client/game-assets/$1" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
